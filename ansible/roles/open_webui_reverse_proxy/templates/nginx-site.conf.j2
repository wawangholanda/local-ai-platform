# Managed by Ansible: local-ai-platform
# Both listeners are restricted to the current Tailscale IPv4 address.

server {
    listen {{ open_webui_proxy_tailscale_ip }}:80;
    server_name {{ open_webui_proxy_domain }};

    return 301 https://$host$request_uri;
}

server {
    listen {{ open_webui_proxy_tailscale_ip }}:443 ssl http2;
    server_name {{ open_webui_proxy_domain }};

    server_tokens off;

    ssl_certificate     {{ open_webui_proxy_certificate_dir }}/fullchain.pem;
    ssl_certificate_key {{ open_webui_proxy_certificate_dir }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:OPENWEBUI_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 50m;

    location / {
        proxy_pass {{ open_webui_proxy_backend }};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Open WebUI uses WebSockets for interactive features.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
