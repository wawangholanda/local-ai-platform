# Cloudflare API token.
# Required permissions: Zone / Read, DNS / Read, and DNS / Edit for the target zone.
CLOUDFLARE_API_TOKEN=

# Dedicated subdomain for the private Open WebUI service.
OPEN_WEBUI_DOMAIN=chat.yourdomain.com

# Stable bearer token for the private Ollama API reverse proxy.
# Generated automatically by quick-start.sh when missing.
OLLAMA_API_KEY=

